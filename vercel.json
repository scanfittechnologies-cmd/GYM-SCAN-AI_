{
  "name": "gym-scan-ai",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_BACKEND_URL": "https://scanner-app-fydt.onrender.com"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(xmlrpc|phpmyadmin|pma)(.*)",
      "destination": "/",
      "permanent": false
    }
  ]
}
