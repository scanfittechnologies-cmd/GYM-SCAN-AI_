# ==============================================================================
# Gym Scan AI - Environment Variables Configuration Template
# Copy this file to '.env' and fill in your credentials for production or staging.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Backend (Optional - App falls back to local engine if empty)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Public Anon Key (Safe for browser client usage with RLS enabled)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. AI Vision Service (Optional - for live Neural Vision machine identification)
# ------------------------------------------------------------------------------
# Google Gemini 1.5 Flash Vision or OpenAI Vision API Key
VITE_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Roboflow Inference API (Optional / Alternative Detection Engine)
# ------------------------------------------------------------------------------
# Your Roboflow API Key from app.roboflow.com
ROBOFLOW_API_KEY=
# Your Roboflow Model ID and Version (e.g. gym-machines-detector/1)
ROBOFLOW_MODEL_ID=

# ------------------------------------------------------------------------------
# 4. Administrative Settings
# ------------------------------------------------------------------------------
# Comma-separated list of admin email addresses with automatic admin privileges
VITE_ADMIN_EMAILS=admin@gymscan.ai,superadmin@gymscan.ai

# Environment mode: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 5. Live Backend Server URL
# ------------------------------------------------------------------------------
# Official production Render backend (do NOT change for production deployments):
VITE_BACKEND_URL=https://scanner-app-fydt.onrender.com
# For local backend dev only: http://localhost:3001
